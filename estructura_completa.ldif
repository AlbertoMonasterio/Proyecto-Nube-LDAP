# 1. Crear el grupo (Unidad Organizativa) de Estudiantes
dn: ou=estudiantes,dc=proyecto,dc=ucab
objectClass: organizationalUnit
ou: estudiantes

# 2. Crear el grupo (Unidad Organizativa) de Profesores
dn: ou=profesores,dc=proyecto,dc=ucab
objectClass: organizationalUnit
ou: profesores

# 3. Crear el grupo (Unidad Organizativa) de Administrativos
dn: ou=administrativo,dc=proyecto,dc=ucab
objectClass: organizationalUnit
ou: administrativo

